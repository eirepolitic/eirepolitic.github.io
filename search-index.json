---
layout: null
permalink: /search-index.json
---
[
{% assign searchable_docs = site.docs | where_exp: 'doc', "doc.visibility != 'private'" %}
{% for doc in searchable_docs %}
  {
    "title": {{ doc.title | jsonify }},
    "summary": {{ doc.summary | default: '' | jsonify }},
    "url": {{ doc.url | relative_url | jsonify }},
    "section": {{ doc.section | default: '' | jsonify }},
    "doc_type": {{ doc.doc_type | default: '' | jsonify }},
    "status": {{ doc.status | default: '' | jsonify }},
    "repository": {{ doc.repository | default: '' | jsonify }},
    "technologies": {{ doc.technologies | default: empty | jsonify }},
    "tags": {{ doc.tags | default: empty | jsonify }},
    "updated": {{ doc.updated | date: '%Y-%m-%d' | jsonify }},
    "content": {{ doc.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
