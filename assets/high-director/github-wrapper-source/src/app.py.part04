@app.put("/repos/{repo}/variables/{name}")
def set_variable(repo: str, name: str, body: VariableSetRequest, x_api_key: Optional[str] = Header(default=None)) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)

    try:
        with gh_client() as client:
            create_resp = client.post(
                f"/repos/{GITHUB_OWNER}/{repo}/actions/variables",
                json={"name": name, "value": body.value},
            )
            if create_resp.status_code == 409:
                update_resp = client.patch(
                    f"/repos/{GITHUB_OWNER}/{repo}/actions/variables/{name}",
                    json={"name": name, "value": body.value},
                )
                if update_resp.status_code != 204:
                    raise AppError(
                        update_resp.status_code,
                        "github_error",
                        "Failed to update repository variable",
                        {"github_response": parse_response_body(update_resp)},
                    )
                return success(
                    message="variable updated",
                    result={"repo": repo, "owner": GITHUB_OWNER, "name": name, "status": "updated"},
                )

            if create_resp.status_code != 201:
                raise AppError(
                    create_resp.status_code,
                    "github_error",
                    "Failed to create repository variable",
                    {"github_response": parse_response_body(create_resp)},
                )
    except httpx.TimeoutException as exc:
        raise AppError(504, "github_timeout", "Timed out setting repository variable", {"exception": str(exc)}) from exc
    except httpx.HTTPError as exc:
        raise AppError(502, "github_transport_error", "Transport error setting repository variable", {"exception": str(exc)}) from exc

    return success(
        message="variable created",
        result={"repo": repo, "owner": GITHUB_OWNER, "name": name, "status": "created"},
    )


@app.delete("/repos/{repo}/variables/{name}")
def remove_variable(repo: str, name: str, x_api_key: Optional[str] = Header(default=None)) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    gh_request("DELETE", f"/repos/{GITHUB_OWNER}/{repo}/actions/variables/{name}", expected=(204,))

    return success(
        message="variable deleted",
        result={"repo": repo, "owner": GITHUB_OWNER, "name": name, "status": "deleted"},
    )


@app.put("/repos/{repo}/secrets/{name}")
def set_secret(repo: str, name: str, body: SecretSetRequest, x_api_key: Optional[str] = Header(default=None)) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    key_data = get_repo_public_key(repo)
    encrypted_value = encrypt_secret(key_data["key"], body.plaintext_value)
    gh_request(
        "PUT",
        f"/repos/{GITHUB_OWNER}/{repo}/actions/secrets/{name}",
        expected=(201, 204),
        json={"encrypted_value": encrypted_value, "key_id": key_data["key_id"]},
    )

    return success(
        message="secret stored",
        result={"repo": repo, "owner": GITHUB_OWNER, "name": name, "status": "set"},
    )


@app.delete("/repos/{repo}/secrets/{name}")
