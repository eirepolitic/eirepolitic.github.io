@app.post("/repos/{repo}/workflows/{workflow_id}/dispatch")
def dispatch_workflow(repo: str, workflow_id: str, body: DispatchWorkflowRequest, x_api_key: Optional[str] = Header(default=None)) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    gh_request(
        "POST",
        f"/repos/{GITHUB_OWNER}/{repo}/actions/workflows/{workflow_id}/dispatches",
        expected=(204,),
        json={"ref": body.ref, "inputs": body.inputs},
    )

    return success(
        message="workflow dispatched",
        result={
            "repo": repo,
            "owner": GITHUB_OWNER,
            "workflow_id": workflow_id,
            "ref": body.ref,
            "inputs": body.inputs,
            "status": "dispatched",
        },
    )


