    return success(
        message="branch created",
        result={
            "repo": repo,
            "owner": GITHUB_OWNER,
            "new_branch": new_branch,
            "from_branch": from_branch,
            "status": "created",
        },
    )


@app.delete("/repos/{repo}/branches/{branch_name:path}")
def delete_branch_endpoint(
    repo: str,
    branch_name: str,
    x_api_key: Optional[str] = Header(default=None),
) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    delete_branch(repo, branch_name)

    return success(
        message="branch deleted",
        result={
            "repo": repo,
            "owner": GITHUB_OWNER,
            "branch_name": branch_name,
            "status": "deleted",
        },
    )


@app.post("/repos/{repo}/pull-requests")
def create_pull_request(repo: str, body: PullRequestCreateRequest, x_api_key: Optional[str] = Header(default=None)) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    base_branch = body.base_branch or get_default_branch(repo)
    resp = gh_request(
        "POST",
        f"/repos/{GITHUB_OWNER}/{repo}/pulls",
        expected=(201,),
        json={
            "title": body.title,
            "body": body.body or "",
            "head": body.head_branch,
            "base": base_branch,
            "draft": body.draft,
        },
    )
    pr = resp.json()

    return success(
        message="pull request created",
        result={
            "repo": repo,
            "owner": GITHUB_OWNER,
            "number": pr.get("number"),
            "url": pr.get("html_url"),
            "state": pr.get("state"),
            "head": (pr.get("head") or {}).get("ref"),
            "base": (pr.get("base") or {}).get("ref"),
        },
    )


@app.get("/repos/{repo}/pull-requests")
def list_pull_requests(
    repo: str,
    state: str = "open",
    head: Optional[str] = None,
    base: Optional[str] = None,
    per_page: int = 30,
    page: int = 1,
    x_api_key: Optional[str] = Header(default=None),
) -> JSONResponse:
    require_api_key(x_api_key)
    repo = normalize_repo_name(repo)
    params: Dict[str, Any] = {"state": state, "per_page": per_page, "page": page}
    if head:
        params["head"] = f"{GITHUB_OWNER}:{head}" if ":" not in head else head
    if base:
        params["base"] = base

    resp = gh_request("GET", f"/repos/{GITHUB_OWNER}/{repo}/pulls", params=params)
    prs = resp.json()

    return success(
        message="pull requests fetched",
        result={
            "repo": repo,
            "owner": GITHUB_OWNER,
            "count": len(prs),
            "pull_requests": [
                {
                    "number": pr.get("number"),
                    "title": pr.get("title"),
                    "state": pr.get("state"),
                    "draft": pr.get("draft"),
                    "merged_at": pr.get("merged_at"),
                    "head": (pr.get("head") or {}).get("ref"),
                    "base": (pr.get("base") or {}).get("ref"),
                    "url": pr.get("html_url"),
                }
                for pr in prs
            ],
        },
    )


@app.get("/repos/{repo}/pull-requests/{number}")
def get_pull_request(
    repo: str,
